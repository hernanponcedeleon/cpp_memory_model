{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  int a = atomic_load_explicit(y, memory_order_relaxed);
  atomic_fetch_add_explicit(x, 1, memory_order_relaxed);
}

P1 (int* x, int* y) {
  int b = atomic_fetch_add_explicit(x, 0, memory_order_acquire);
  if (b != 0) {
    *y = 1;
  }
}

forall(0:a=0 \/ 0:a=1)
C Issue#7
{ [data] = 0; [flag] = 0; [zero] = 0; }

P0 (int* data, int* flag, int* zero) {
    *data = 42;
    // always succeeds:
    atomic_compare_exchange_strong_explicit(flag, zero, 0, memory_order_acq_rel, memory_order_acq_rel);
    atomic_fetch_add_explicit(flag, 1, memory_order_relaxed); // extend release-sequence
}

P1 (int* data, int* flag) {
    int r0 = atomic_load_explicit(flag, memory_order_acquire);
    if (r0 == 1) {
        int r1 = *data; // well-defined: reads 42 if r0 != 0
    }
}

forall(1:r0 = 0 \/ (1:r0 != 0 /\ 1:r1 = 42))